# Banco local (Docker Compose): use o host postgres na rede interna
# DATABASE_URL="postgresql://etholys:etholys_dev_change_me@postgres:5432/etholys"
# No Windows/MAC, rodando npm run dev FORA do Docker com Postgres na porta 5433:
DATABASE_URL="postgresql://etholys:etholys_dev_change_me@localhost:5433/etholys"

# Obrigatório — sem isto login e convites falham. Em produção use o domínio público (ex.: https://etholys.abacusai.app).
# Convites e links de alunos usam SEMPRE este valor.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-um-segredo-longo-aleatorio"

# Pré-comercial (produção sem venda pública)
# true = só platform admins + company ADMIN vêem Hub; convites só por função
ETHOLYS_PRECOMMERCIAL=true
NEXT_PUBLIC_ETHOLYS_PRECOMMERCIAL=true
# Emails com acesso completo (além de User.role=ADMIN e CompanyUser ADMIN)
ETHOLYS_PLATFORM_ADMIN_EMAILS=tiagorezende@ruralcommerceglobal.com


# OAuth (opcional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Meet F6 — pedir scope calendar.events no login Google (utilizadores devem re-autorizar)
# GOOGLE_CALENDAR_ENABLED=1
# Outlook Calendar (NextAuth Azure AD)
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=common

# --- Etholys Meet (gravação / STT / Jibri) ---
# JITSI_BASE_URL=https://meet.etholys.com
# NEXT_PUBLIC_JITSI_BASE_URL=https://meet.etholys.com
# MEET_JIBRI_WEBHOOK_SECRET=
# A app só mostra os controlos quando os serviços existem no Jitsi:
# MEET_LIVE_TRANSCRIPTION_ENABLED=1
# MEET_CLOUD_RECORDING_ENABLED=1
# Object storage (S3 ou Cloudflare R2)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_FOLDER_PREFIX=
# R2_ACCOUNT_ID=
# AWS_ENDPOINT_URL=
# AWS_PUBLIC_BASE_URL=
# Whisper STT
# OPENAI_API_KEY=
# MEET_TRANSCRIBE_MODEL=whisper-1

# Convites FORGE (opcional — sem isto o link mágico aparece na UI ao invitar)
# RESEND_API_KEY=
# AUTH_EMAIL_FROM="Etholys <noreply@etholys.com>"
# FORGE_EMAIL_FROM="Etholys <noreply@etholys.com>"
# Recordatorios automáticos (cron): POST /api/forge/cron/reminders con Bearer token
# FORGE_CRON_SECRET="gere-um-segredo-longo"
# E2E Playwright (só dev): POST /api/forge/e2e/seed com Bearer
# FORGE_E2E_SECRET="gere-um-segredo-longo"
# Cron diario sugerido:
# POST /api/forge/cron/reminders
# POST /api/forge/cron/auto-nudges

# S3 / notificações: manter do seu ambiente se precisar

# --- LLM (SIEP, MUSE, NEXUS, FORGE, Meet, importações, extratos) ---
# Chave da API LLM (variável aceite: ANTHROPIC_API_KEY ou LLM_API_KEY)
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-4-6
# Se 429/503, a app tenta fallbacks:
# LLM_FALLBACK_MODELS=claude-haiku-4-5,claude-opus-4-6
# Predefinido: 32000 (máx. 64000)
# LLM_MAX_OUTPUT_TOKENS=32000
# Redacção SIEP (opcional, modelo mais forte):
# LLM_SIEP_REPORT_MODEL=claude-opus-4-6

# OPPORTUNITY — pesquisa web na varredura (tool web_search)
# Desactivar: OPPORTUNITY_WEB_SEARCH=0
# OPPORTUNITY_WEB_SEARCH=1

# --- Lab ANVIL (agente engenharia interno) ---
# Owners (CSV). Sem isto, qualquer User.role=ADMIN conta como owner (bootstrap).
# LAB_ANVIL_OWNER_EMAILS="admin@etholys.com"

# --- Backend FastAPI (contentor `api` no Docker usa o mesmo ficheiro .env) ---
# AI_PROVIDER=anthropic

# --- PDF/HTML para relatórios (não é LLM; serviço Abacus ou outro) ---
# ABACUSAI_API_KEY=
# HTML2PDF_API_KEY=
