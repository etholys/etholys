# Copie para apps/web/.env no servidor (valores de PRODUÇÃO)
# cp .env.production.example .env

# URL EXACTA que os alunos abrem no browser (HTTPS, sem barra no fim)
NEXTAUTH_URL=https://forge.etholys.com
NEXTAUTH_SECRET=GERE_COM_openssl_rand_base64_32

# O docker-compose.prod.yml injeta DATABASE_URL para o contentor web.
# Para scripts locais no servidor (seed), use o mesmo host postgres:5432 dentro da rede
# ou localhost se expuser porta (não recomendado).

# Convites e recuperação de senha (Resend — https://resend.com/domains)
# 1. Verifique etholys.com no Resend (registos DNS SPF + DKIM no Cloudflare)
# 2. Copie a API key e configure no servidor:
#    RESEND_API_KEY=re_xxx bash scripts/configure-email-production.sh
# RESEND_API_KEY=re_...
AUTH_EMAIL_FROM="Etholys <noreply@etholys.com>"
FORGE_EMAIL_FROM="Etholys <noreply@etholys.com>"

# LLM da app (SIEP, NEXUS, FORGE, Meet, importações)
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-6

# Lab ANVIL — owners (CSV). Sem isto, ADMIN = owner (só bootstrap).
# LAB_ANVIL_OWNER_EMAILS="admin@etholys.com"

# Pré-comercial — fechar Hub/login público
ETHOLYS_PRECOMMERCIAL=true
NEXT_PUBLIC_ETHOLYS_PRECOMMERCIAL=true
ETHOLYS_PLATFORM_ADMIN_EMAILS=etholys@gmail.com

# Etholys Meet — Jitsi no Contabo (obrigatório em produção; sem isto = meet.jit.si)
# Ver docs/MEET-JITSI-CONTABO.md
JITSI_BASE_URL=https://meet.etholys.com
NEXT_PUBLIC_JITSI_BASE_URL=https://meet.etholys.com

# Meet — gravação / Jibri / R2 / STT (ver docs/MEET-VPS-JIBRI.md)
# MEET_JIBRI_WEBHOOK_SECRET=
# Só activar depois de subir Jigasi/Jibri no servidor Jitsi:
# MEET_LIVE_TRANSCRIPTION_ENABLED=1
# MEET_CLOUD_RECORDING_ENABLED=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# R2_ACCOUNT_ID=
# AWS_PUBLIC_BASE_URL=
# OPENAI_API_KEY=
# GOOGLE_CALENDAR_ENABLED=1
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
