{
  "name": "etholys-meet-capture",
  "version": "0.1.0",
  "private": true,
  "description": "Etholys Meet Capture — shell desktop para gravação/transcrição de reuniões externas",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.etholys.meet-capture",
    "productName": "Etholys Meet Capture",
    "directories": { "output": "dist" },
    "win": {
      "target": ["portable"]
    }
  }
}
