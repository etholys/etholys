# Copie para infra/.env (mesma pasta que docker-compose.prod.yml)
# cp .env.production.example .env

# Domínio público da app (Hub / SIEP / FORGE)
APP_DOMAIN=app.etholys.com

# Etholys Meet — Jitsi self-hosted (Caddy faz TLS → host:8000)
# DNS: A meet → IP Contabo. Script: scripts/setup-jitsi-contabo.sh
MEET_DOMAIN=meet.etholys.com

# Postgres (senha forte — só dentro da rede Docker)
POSTGRES_USER=etholys
POSTGRES_PASSWORD=GERE_SENHA_LONGA_AQUI
POSTGRES_DB=etholys
